# Umbral de referencia (pb) que se dibuja como línea punteada en el gráfico de riesgo país
NEXT_PUBLIC_UMBRAL_RIESGO=500

# api.bcra.gob.ar suele servir una cadena TLS incompleta y Node la rechaza.
# Con 1, el backend reintenta SOLO contra el BCRA sin validar el certificado (datos públicos, solo lectura).
BCRA_INSECURE_TLS=1
